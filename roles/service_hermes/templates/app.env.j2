# Rendered by roles/service_hermes to {{ hermes_config_dir }}/app.env, mode 0600.
#
# THIS FILE HOLDS LIVE CREDENTIALS. It exists only on the target host at render time; it is
# never committed, and the task that writes it is no_log.
{# This template carries placeholders, not values, and a RENDERED app.env must never be copied
   back into a repository. #}
#
# WHY THIS FILE EXISTS AT ALL, rather than running Hermes's setup wizard: `hermes setup` is
# INTERACTIVE and writes /opt/data/.env itself, which cannot be driven from a play and would
# not be idempotent. Upstream's Docker guide states API keys are read from /opt/data/.env and
# that environment variables may be passed directly instead -- so rendering the environment is
# the supported unattended path, not a workaround. The container's cont-init hook only SEEDS a
# MISSING .env, so this managed file is never clobbered on restart or upgrade.
#
# Only a provider whose key resolved non-empty gets a line: an exported-but-empty variable
# reads to Hermes as a configured provider that cannot authenticate, which fails at REQUEST
# time rather than at deploy time.

# NOTE: NO PROVIDER CREDENTIAL IS RENDERED HERE, and that is the design.
#
{# All model traffic routes through an OpenAI-compatible gateway (LiteLLM, say), which is
   configured in the agent's own config.yaml as a `providers.<name>` entry (see config.yaml.j2)
   rather than through an environment variable -- this project has no generic chat
   OPENAI_BASE_URL, so an env-var approach would be a silent no-op that merely looks configured.

   Hermes therefore never holds a provider key at all: one key, held by the gateway, gives one
   spend ledger, one rotation and one place where models are configured. #}
{% if hermes_gateway_url | default('') | length > 0 and hermes_gateway_api_key | default('') | length > 0 %}

# ---- the gateway's VIRTUAL key ------------------------------------------------------------
# config.yaml carries only `key_env: {{ hermes_gateway_key_env }}`; the value is here and nowhere
# else. It must NOT also appear in data/.env, which would win (override=True): _config_merge.yml
# asserts that by a count-only read.
{{ hermes_gateway_key_env }}={{ hermes_gateway_api_key }}
{% endif %}

{% if hermes_dashboard_enabled | bool %}

# ---- dashboard ---------------------------------------------------------------------------
# The service is REGISTERED but stays down unless this is set.
HERMES_DASHBOARD=1
# Bind inside the container. 0.0.0.0 is required for the published port to be reachable at
# all -- a 127.0.0.1 bind here makes `ports:` silently useless. The auth gate below is what
# makes that safe, and Hermes REFUSES TO START the dashboard on a non-loopback bind with no
# auth provider registered (it fails closed naming the missing variable).
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT={{ hermes_dashboard_host_port }}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_username }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ hermes_dashboard_password }}
{% if hermes_dashboard_auth_secret | default('') | length > 0 %}
# Without a stable secret, every container restart invalidates every dashboard session.
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ hermes_dashboard_auth_secret }}
{% endif %}
{% endif %}
{% if hermes_api_server_enabled | bool %}

# ---- OpenAI-compatible API server --------------------------------------------------------
# OFF unless explicitly enabled: a caller holding this key does not just read, it DRIVES THE
# AGENT, which executes tools. Upstream requires the key to leave loopback at all.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT={{ hermes_api_host_port }}
API_SERVER_KEY={{ hermes_api_server_key }}
{% endif %}
{% if hermes_webhook_enabled | default(false) | bool %}

# ---- webhook listener --------------------------------------------------------------------
# The global route secret. Here and NOT in config.yaml: the gateway's env layer sets
# platforms.webhook.extra.secret from WEBHOOK_SECRET, and config.yaml (plus its managed copy) is
# readable by more than root.
WEBHOOK_SECRET={{ hermes_webhook_secret }}
{% for _name, _value in (hermes_webhook_route_secrets | default({})).items() %}
{{ _name }}={{ _value }}
{% endfor %}
{% endif %}
{% if hermes_email_enabled | default(false) | bool %}

# ---- the agent's own mailbox -------------------------------------------------------------
# IMAP poll + SMTP reply. Only allowlisted, AUTHENTICATED senders become a turn: the adapter acts
# only when the topmost Authentication-Results header (stamped by EMAIL_AUTHSERV_ID) passes.
EMAIL_ADDRESS={{ hermes_email_address }}
EMAIL_PASSWORD={{ hermes_email_password }}
EMAIL_IMAP_HOST={{ hermes_email_imap_host }}
EMAIL_IMAP_PORT={{ hermes_email_imap_port }}
EMAIL_SMTP_HOST={{ hermes_email_smtp_host }}
EMAIL_SMTP_PORT={{ hermes_email_smtp_port }}
EMAIL_ALLOWED_USERS={{ hermes_email_allowed_users | join(',') }}
EMAIL_AUTHSERV_ID={{ hermes_email_authserv_id }}
{% endif %}
{% if (hermes_cron_env | default({})) | length > 0 %}

# ---- cron script credentials -------------------------------------------------------------
# Reach a cron script only because terminal.env_passthrough (tier C) names them.
{% for _name, _value in hermes_cron_env.items() %}
{{ _name }}={{ _value }}
{% endfor %}
{% endif %}
{% if hermes_observability_prometheus_url | default('') | length > 0 or hermes_observability_loki_url | default('') | length > 0 or hermes_observability_grafana_token | default('') | length > 0 %}

# ---- observability READ ------------------------------------------------------------------
# Query URLs and a Grafana VIEWER service-account token. Read only: Prometheus and Loki expose
# no write on their query APIs, and the token's role is Viewer.
{% if hermes_observability_prometheus_url | default('') | length > 0 %}
PROMETHEUS_URL={{ hermes_observability_prometheus_url }}
{% endif %}
{% if hermes_observability_loki_url | default('') | length > 0 %}
LOKI_URL={{ hermes_observability_loki_url }}
{% endif %}
{% if hermes_observability_grafana_token | default('') | length > 0 and hermes_observability_grafana_url | default('') | length > 0 %}
GRAFANA_URL={{ hermes_observability_grafana_url }}
GRAFANA_TOKEN={{ hermes_observability_grafana_token }}
{% endif %}
{% endif %}
{% if hermes_slack_enabled | default(false) | bool %}

# ---- Slack, Socket Mode ------------------------------------------------------------------
# Outbound WebSocket only: no inbound port, nothing published. The allowlist is the gate: a
# member not listed here is dropped and logged by the gateway ("Unauthorized user ..."), and
# config.yaml's unauthorized_dm_behavior=ignore (inventory) stops it being sent a pairing code.
SLACK_BOT_TOKEN={{ hermes_slack_bot_token }}
SLACK_APP_TOKEN={{ hermes_slack_app_token }}
SLACK_ALLOWED_USERS={{ hermes_slack_allow_from | join(',') }}
{% if hermes_slack_home_channel | default('') | length > 0 %}
SLACK_HOME_CHANNEL={{ hermes_slack_home_channel }}
{% endif %}
{% endif %}
