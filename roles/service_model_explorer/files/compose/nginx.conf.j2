# Rendered by roles/service_model_explorer. Do not edit on the host.
#
# A static-file server for one single-page app. Nothing dynamic, no upstream, no credential.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The catalogue is the one file that goes stale, and a cached copy is worse than a slow
    # one: the whole point of the app is to show CURRENT state, and a browser serving a
    # fortnight-old snapshot from cache would present retired models as available with no
    # indication anything was wrong. The app's own `cache: "no-store"` asks for this too; this
    # makes it true from the server side as well, where it cannot be bypassed.
    location = /catalogue.json {
        add_header Cache-Control "no-store, must-revalidate" always;
        expires -1;
        default_type application/json;
    }

    # Hashed bundle assets are immutable by construction (the hash changes when content does),
    # so they are safe to cache hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # SPA fallback. The app has no client-side router today, but a direct hit on any other path
    # should land on the app rather than nginx's 404 page.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # This app renders NO user input and loads no third-party script: every asset is same-origin
    # from the bundle. So the policy can be strict, which is cheap insurance for a page that
    # displays strings fetched from an upstream catalogue.
    #
    # 'unsafe-inline' is present for style-src ONLY, and is load-bearing: the React build injects
    # its stylesheet and some inline style attributes. script-src stays strict.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Nothing here is secret, but there is no reason to advertise the exact nginx build.
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
