---
# Rendered by roles/service_model_explorer. Do not edit on the host -- the next converge
# overwrites it.
#
# ONE container: the app's released image (nginx, running as a non-root user, serving the built
# app). The image is pinned by DIGEST and carries its own nginx config and HEALTHCHECK; the only
# input is the catalogue snapshot, mounted read-only.
{# NO CREDENTIAL REACHES THIS CONTAINER. The app is read-only: it fetches one JSON snapshot of
   model ids and holds no key. Adding a model to Open WebUI's picker is STAGED in the UI and
   applied by an Ansible play, so this container needs no write path at all.

   No reverse-proxy labels: a reverse proxy in front of this container is configured by the
   caller, which also keeps Jinja out of YAML mapping keys — a templated label key would ship the
   literal braces. #}
services:
  {{ model_explorer_container_name }}:
    image: {{ model_explorer_image }}
    container_name: {{ model_explorer_container_name }}
    restart: unless-stopped
    read_only: true
    tmpfs:
      # nginx's pid file and temp paths (the unprivileged image keeps them under /tmp).
      - /tmp
    environment:
      TZ: "{{ model_explorer_timezone }}"
    volumes:
      # The DIRECTORY holding catalogue.json, not the file: a file-level bind mount pins the inode,
      # and the snapshot is replaced by an atomic rename, so the container would keep serving the
      # old one. Read-only: nothing in this app writes.
      - {{ model_explorer_config_dir }}/catalogue:/srv/catalogue:ro
    ports:
      - "{{ model_explorer_host_port }}:8080"
    networks:
      - {{ model_explorer_network }}

networks:
  {{ model_explorer_network }}:
    external: true
