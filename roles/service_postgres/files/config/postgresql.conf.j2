# PostgreSQL configuration file generated by Ansible

listen_addresses = '{{ postgres_settings.listen_addresses }}'
max_connections = {{ postgres_settings.max_connections }}
shared_buffers = '{{ postgres_settings.shared_buffers }}'
work_mem = '{{ postgres_settings.work_mem }}'
maintenance_work_mem = '{{ postgres_settings.maintenance_work_mem }}'
effective_cache_size = '{{ postgres_settings.effective_cache_size }}'

log_min_duration_statement = {{ postgres_settings.log_min_duration_statement }}
logging_collector = {{ postgres_settings.logging_collector }}
log_directory = '{{ postgres_settings.log_directory }}'
log_filename = '{{ postgres_settings.log_filename }}'
log_statement = '{{ postgres_settings.log_statement }}'

timezone = '{{ postgres_settings.timezone }}'
