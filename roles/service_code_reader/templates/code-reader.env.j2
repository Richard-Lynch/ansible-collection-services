# provider, not generated here. A single-quoted value is taken literally. The one character a
# single-quoted value cannot carry is the quote itself, which the role's preflight refuses.
IMAP_PASSWORD='{{ code_reader_imap_password }}'
CODE_READER_TOKEN='{{ code_reader_token }}'
