# Rendered by roles/service_litellm to {{ litellm_config_dir }}/app.env, mode 0600.
#
# THIS FILE HOLDS LIVE CREDENTIALS. It exists only on the target host at render time; it is
# never committed, and the task that writes it is no_log.
{# This template carries placeholders, not values; a RENDERED app.env must never be copied
   back into a repository. #}
#
# Only providers whose key resolved non-empty get a line: an exported-but-empty variable
# reads to LiteLLM as a configured provider that cannot authenticate.

LITELLM_MASTER_KEY={{ litellm_master_key }}
# IMMUTABLE. Encrypts provider credentials at rest in Postgres. If this value ever changes,
# every key already stored becomes undecryptable -- there is no recovery but re-entering them.
LITELLM_SALT_KEY={{ litellm_salt_key }}

DATABASE_URL=postgresql://{{ litellm_postgres_user }}:{{ litellm_postgres_password }}@{{ litellm_postgres_container_name }}:5432/{{ litellm_postgres_db }}
{% if litellm_redis_enabled | bool %}

# Shared state across the proxy's workers. LiteLLM reads REDIS_* from the environment directly
# (litellm/_redis.py `_redis_kwargs_from_environment`), so these three variables ARE the whole
# configuration — no cache block in config.yaml is needed, and adding one alongside these would
# be a second place that decides where Redis is.
REDIS_HOST={{ litellm_redis_container_name }}
REDIS_PORT=6379
REDIS_PASSWORD={{ litellm_redis_password }}
{% endif %}

{% if litellm_anthropic_api_key | default('') | length > 0 %}
ANTHROPIC_API_KEY={{ litellm_anthropic_api_key }}
{% endif %}
{% if litellm_openai_api_key | default('') | length > 0 %}
OPENAI_API_KEY={{ litellm_openai_api_key }}
{% endif %}
{% if litellm_gemini_api_key | default('') | length > 0 %}
GEMINI_API_KEY={{ litellm_gemini_api_key }}
{% endif %}
{% if litellm_openrouter_api_key | default('') | length > 0 %}
OPENROUTER_API_KEY={{ litellm_openrouter_api_key }}
{% endif %}
{% if litellm_elevenlabs_api_key | default('') | length > 0 %}
# ElevenLabs TTS. The variable name is what litellm's own transformation reads:
# ElevenLabsTextToSpeechConfig.validate_environment falls back to get_secret_str("ELEVENLABS_API_KEY")
# and sends it upstream as the `xi-api-key` header (v1.104.2 source).
ELEVENLABS_API_KEY={{ litellm_elevenlabs_api_key }}
{% endif %}
{% if litellm_brave_search_api_key | default('') | length > 0 %}
# Brave Search. Read by BraveSearchConfig.validate_environment via
# key_env_vars=("BRAVE_API_KEY",) and sent as the `X-Subscription-Token` header — NOT as a
# bearer token, which is why the search_tools entry references this variable rather than
# relying on a generic auth type.
BRAVE_API_KEY={{ litellm_brave_search_api_key }}
{% endif %}
{% if litellm_typesafe_api_key | default('') | length > 0 %}
# TypeSafe AI (Jev) — a PASS-THROUGH upstream, not a model_list entry. Jev returns typed
# DECISIONS (a probability, a choice, a score) from its own /v1/systemone endpoint rather than
# chat completions, so LiteLLM proxies it at /typesafe/* and there is no `typesafe/` provider in
# its model registry. Setting this variable is the whole configuration.
TYPESAFE_API_KEY={{ litellm_typesafe_api_key }}
{% endif %}
