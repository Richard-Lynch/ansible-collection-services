{#
  Rendered by stack_arr_jellystat to <jellystat_config_dir>/docker-compose.yml. COMPOSE LAYER
  ONLY: never touches ./data/postgres-data (the database's own files) or ./data/backup-data
  contents — those are runtime state owned by postgres/jellystat.
#}
services:
  jellystat:
    image: {{ jellystat_image }}
    container_name: jellystat
    restart: unless-stopped
    depends_on:
      - jellystat-db
    networks:
      - {{ jellystat_network }}
    volumes:
      - ./data/backup-data:/app/backend/backup-data:rw
    environment:
      POSTGRES_USER: {{ jellystat_postgres_user }}
      POSTGRES_PASSWORD: "{{ jellystat_postgres_password }}"
      POSTGRES_IP: jellystat-db
      POSTGRES_PORT: 5432
      JWT_SECRET: "{{ jellystat_jwt_secret }}"
      TZ: Etc/UTC
    labels:
      traefik.enable: true
      traefik.http.routers.jellystat.service: jellystat
      traefik.http.routers.jellystat.entrypoints: websecure
      traefik.http.routers.jellystat.rule: "{{ jellystat_traefik_hosts | map('regex_replace', '^(.*)$', 'Host(`\\1`)') | join(' || ') }}"
      traefik.http.services.jellystat.loadbalancer.server.port: 3000
      traefik.http.routers.jellystat.tls: true

  jellystat-db:
    image: {{ jellystat_db_image }}
    container_name: jellystat-db
    restart: unless-stopped
    shm_size: 1gb
    networks:
      - {{ jellystat_network }}
    environment:
      POSTGRES_USER: {{ jellystat_postgres_user }}
      POSTGRES_PASSWORD: "{{ jellystat_postgres_password }}"
      TZ: Etc/UTC
    volumes:
      - ./data/postgres-data:/var/lib/postgresql/data:rw

networks:
  {{ jellystat_network }}:
    external: true
