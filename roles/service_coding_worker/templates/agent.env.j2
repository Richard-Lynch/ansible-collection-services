# managed by service_coding_worker: the agents' environment (0600, the worker user).
# Sourced with `set -a`; sessiond forwards exactly the names assigned here into each card container.
ANTHROPIC_BASE_URL='{{ worker_litellm_url }}'
ANTHROPIC_AUTH_TOKEN='{{ worker_litellm_api_key | replace("'", "'\\''") }}'
ANTHROPIC_MODEL='{{ worker_claude_model }}'
OPENAI_BASE_URL='{{ worker_litellm_url }}/v1'
OPENAI_API_KEY='{{ worker_litellm_api_key | replace("'", "'\\''") }}'
CODEX_MODEL='{{ worker_codex_model }}'
{% if worker_token_broker_url | length == 0 and worker_github_token | length > 0 %}
GH_TOKEN='{{ worker_github_token | replace("'", "'\\''") }}'
{% endif %}
{% for name, value in (worker_extra_env | dictsort) %}
{{ name }}='{{ value | string | replace("'", "'\\''") }}'
{% endfor %}
